# ==============================================================================
# Global .dockerignore for CommitLens
# Protects against leaking secrets, credentials, and unnecessary files into builds
# ==============================================================================

# Environment files & Secrets
.env
*.env
.env.*
.env*.local
*.key
*.pem
*.pfx
*.pkcs12
*.crt

# Version Control
.git
.gitignore
.gitattributes

# IDE & Editor configurations
.idea/
.vscode/
*.iml
*.iws
*.ipr

# Temporary & Build Directories
target/
node_modules/
.next/
dist/
build/
local/
prod/
docker/
docs/

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
