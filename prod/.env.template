# CommitLens Production Environment Variables Template
# Copy this file to .env before starting containers:
#   cp .env.template .env
# ==============================================================================
# ------------------------------------------------------------------------------
# Container Images (GHCR)
# ------------------------------------------------------------------------------
# Change these tags or repositories if using custom or version-pinned builds
COMMITLENS_API_IMAGE=ghcr.io/demirhany/commit-lens/backend:latest
COMMITLENS_FRONTEND_IMAGE=ghcr.io/demirhany/commit-lens/frontend:latest
# ------------------------------------------------------------------------------
# Port Mappings
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
API_PORT=8100
POSTGRES_DB_PORT=5432
REDIS_PORT=6379
# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=commitlens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_secure_password
# ------------------------------------------------------------------------------
# Spring Backend Configuration
# ------------------------------------------------------------------------------
SPRING_JPA_HIBERNATE_DDL_AUTO=update
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
INTERNAL_API_URL=http://api:8100
NEXT_PUBLIC_API_URL=http://localhost:8100
# ------------------------------------------------------------------------------
# Third-party Integrations (Optional)
# ------------------------------------------------------------------------------
# GitHub
GITHUB_BASE_URL=https://api.github.com
GITHUB_TOKEN=
# Bitbucket
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_TOKEN=
BITBUCKET_WORKSPACE=
# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=